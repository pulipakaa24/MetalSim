    def invoke_metal(
        kernel,
        hooks,
        params: Sequence[Any],
        device: Device,
        block_dim: int,
        adjoint: bool = False,
        dim_limit: warp.array | None = None,
        det_args=None,
    ):
        """Dispatch a forward or backward kernel on a Metal device.
    
        With ``dim_limit`` (a forward launch), only the threadgroups holding tasks whose leading index is below
        ``dim_limit[0]`` run (see :func:`warp.launch`).
    
        ``det_args`` carries the deterministic-mode buffers of kernels with deterministic lowering
        (``warp._src.metal_deterministic``).
        """
        if hooks.metal_unsupported:
            detail = ""
            if "int64)" in hooks.metal_unsupported:
                detail = (
                    ". Apple GPUs have no 64-bit compare-and-swap (only unsigned 64-bit atomic min/max), so 64-bit "
                    "atomic_cas / atomic_exch and signed 64-bit atomic_min / atomic_max cannot be atomic on Metal; "
                    "use 32-bit atomics (e.g. on one half of the value) instead"
