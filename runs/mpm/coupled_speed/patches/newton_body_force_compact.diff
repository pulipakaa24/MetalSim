+@wp.kernel
+def flag_body_nodes(
+    node_count: int,
+    collider_ids: wp.array[int],
+    body_ids: wp.array[int],
+    flags: wp.array[int],
+):
+    """1 for the grid nodes whose collider belongs to a body, 0 otherwise (the compaction's keep flags)."""
+    i = wp.tid()
+    keep = 0
+    if i < node_count:
+        cid = collider_ids[i]
+        if cid >= 0 and cid < body_ids.shape[0]:
+            if body_ids[cid] >= 0:
+                keep = 1
+    flags[i] = keep
+
+
+@wp.kernel
+def compact_body_nodes(
+    node_count: int,
+    flags: wp.array[int],
+    positions: wp.array[int],
+    nodes: wp.array[int],
+    count: wp.array[int],
+):
+    """Stable compaction: the kept node indices in increasing order, and their count (read on the device)."""
+    i = wp.tid()
+    if flags[i] != 0:
+        nodes[positions[i]] = i
+    if i == node_count - 1:
+        count[0] = positions[i] + flags[i]
+
+
+@wp.kernel
+def compute_body_forces_compact_lanes(
+    dt: float,
+    count: wp.array[int],
+    nodes: wp.array[int],
+    collider_ids: wp.array[int],
+    collider_impulses: wp.array[wp.vec3],
+    collider_impulse_pos: wp.array[wp.vec3],
+    body_ids: wp.array[int],
+    body_q: wp.array[wp.transform],
+    body_com: wp.array[wp.vec3],
+    body_f_lanes: wp.array2d[wp.spatial_vector],
+):
+    """:func:`compute_body_forces_lanes` over the compacted body nodes: lane ``l`` adds the kept nodes
+    ``l, l + L, l + 2L, ...`` (in node order) that belong to its body. The scan reads only the nodes in contact with a
+    body instead of every grid node, for every body."""
+
+    body_index, lane = wp.tid()
+    lane_count = body_f_lanes.shape[1]
+
+    X_wb = body_q[body_index]
+    com = wp.transform_point(X_wb, body_com[body_index])
+
+    f = wp.spatial_vector()
+    for k in range(lane, count[0], lane_count):
+        i = nodes[k]
+        if body_ids[collider_ids[i]] == body_index:
+            f_world = collider_impulses[i] / dt
+            r = collider_impulse_pos[i] - com
+            f += wp.spatial_vector(f_world, wp.cross(r, f_world))
     body_f_lanes[body_index, lane] = f
 
 
