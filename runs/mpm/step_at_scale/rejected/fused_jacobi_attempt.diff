+    def _rigidity_environment_rows(self) -> tuple[wp.array[int], wp.array[int]] | None:
+        """Rows of the rigidity operator's ``IJtm`` (two per body, then deformable collider vertices) grouped by
+        environment, the rows of no environment last; ``None`` unless every row with coupled nodes belongs to one
+        environment (no deformable colliders, no dynamic body outside the environments)."""
+        if not self._separate_worlds:
+            return None
+        mpm_model = self._mpm_model
+        body_mass = mpm_model.collider_body_mass
+        key = (id(body_mass), mpm_model.min_collider_mass)
+        cached = getattr(self, "_rigidity_rows_cache", None)
+        if cached is not None and cached[0] == key:
+            return cached[1]
+        result = None
+        body_world = self.model.body_world
+        if mpm_model.collider.collider_particle_ids.shape[0] == 0 and body_world is not None and body_mass is not None:
+            bw = body_world.numpy()
+            masses = body_mass.numpy()
+            body_ids = mpm_model.collider.collider_body_index.numpy()
+            dyn = body_ids[body_ids >= 0]
+            dyn = dyn[masses[dyn] > 0.0]
+            if not np.any(bw[dyn] < 0):
