+                body_count = self.model.body_count
+                world = np.where(bw[:body_count] >= 0, bw[:body_count], env_count)
+                order = np.argsort(world, kind="stable")
+                rows = np.stack((2 * order, 2 * order + 1), axis=1).reshape(-1).astype(np.int32)
+                counts = np.bincount(world, minlength=env_count + 1)[: env_count + 1] * 2
