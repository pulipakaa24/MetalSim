+# SPDX-FileCopyrightText: Copyright (c) 2026 The Newton Developers
+# SPDX-License-Identifier: Apache-2.0
+
+"""Jacobi rheology iterations of independent environments in one dispatch (Metal).
+
+With ``separate_worlds`` every environment's nodes are a contiguous range of the environment-first velocity, strain
+and collider partitions, and no matrix couples two environments. One iteration of the Jacobi solver with sub-grid
+contact (``_SubgridContactSolver.solve`` then ``_JacobiSolver.solve``) is six full-grid passes, each a separate
+dispatch: friction at collider nodes, collider impulses to velocity nodes, the rigid-body coupling (two BSR
+products), the local stress solve, the stress update of the velocity nodes and the stress accumulation. Here one
+threadgroup runs an environment through ``count`` iterations, the passes separated by threadgroup barriers instead of
+dispatch boundaries. Every node value is computed by one thread with the code of the corresponding kernel (the same
+Warp functions, or the kernel bodies transcribed statement for statement), from the same inputs, so the iterates are
+bitwise those of the dispatch-per-pass loop: within a pass, nodes only read values produced by earlier passes of the
+same environment.
+
+Items that belong to no environment (collider nodes and coupling-matrix rows past the environments' ranges) are
+processed by one extra threadgroup, pass by pass, with the same code; they read nothing written by the environments
+in the same pass (collider rows outside every environment are empty, global bodies have no coupled nodes).
+"""
+
+from __future__ import annotations
+
+import os
+
+import warp as wp
+import warp.fem as fem
+from warp._src.sparse import _bsr_row_end
+
+from .contact_solver_kernels import solve_coulomb_isotropic
+from .rheology_solver_kernels import (
+    YieldParamVec,
+    _symmetric_part_transposed_op,
+    make_compute_local_strain,
+    make_solve_local_stress,
+    mat13,
+    mat55,
+    mat66,
+    vec6,
+)
+
+wp.set_module_options({"enable_backward": False})
+
+BLOCK_DIM = int(os.environ.get("NEWTON_METAL_FUSED_JACOBI_BLOCK", "256"))
+"""Threads per environment (one threadgroup). A multiple of 32."""
+
+
+def threadgroup_size_ok(kernel, device, block_dim: int, num_threads: int) -> bool:
+    """True when a launch of ``kernel`` with ``block_dim`` runs in threadgroups of exactly ``block_dim`` threads.
+
+    Warp's Metal launch uses ``min(block_dim, pipeline.maxTotalThreadsPerThreadgroup)`` threads per threadgroup; a
+    pipeline that cannot hold ``block_dim`` threads (register pressure) would split an environment across
+    threadgroups and leave a partial last threadgroup whose idle threads return before the barriers, so the fused
+    kernel is used only when the whole environment fits one threadgroup.
+    """
+    from warp._src.context import metal_forward_pipeline, runtime  # noqa: PLC0415
+
+    module_exec = kernel.module.load(device, block_dim=block_dim)
+    if module_exec is None:
+        return False
+    hooks = module_exec.get_kernel_hooks(kernel)
+    pipeline = metal_forward_pipeline(hooks, num_threads)
+    if not pipeline:
+        return False
+    max_threads = runtime.core.wp_metal_get_kernel_max_threads_per_threadgroup(pipeline)
+    return block_dim % 32 == 0 and num_threads % block_dim == 0 and max_threads >= block_dim
+
+
+@wp.func_native(
+    "#if defined(__METAL_VERSION__)\n"
+    "metal::threadgroup_barrier(metal::mem_flags::mem_device | metal::mem_flags::mem_threadgroup);\n"
+    "#endif\n"
+)
+def _tg_barrier(): ...
+
+
+# --- per-node bodies of the dispatched kernels (statement for statement) ---------------------------------------------
+
+
+@wp.func
+def _solve_subgrid_friction_node(
+    i: int,
+    velocity: wp.array[wp.vec3],
+    collider_mat_offsets: wp.array[int],
+    collider_mat_columns: wp.array[int],
+    collider_mat_values: wp.array[float],
+    collider_friction: wp.array[float],
+    collider_adhesion: wp.array[float],
+    collider_normals: wp.array[wp.vec3],
+    collider_delassus_diagonal: wp.array[float],
+    collider_velocities: wp.array[wp.vec3],
+    impulse: wp.array[wp.vec3],
+    delta_impulse: wp.array[wp.vec3],
+):
+    # contact_solver_kernels.solve_subgrid_friction
+    w = collider_delassus_diagonal[i]
+    friction_coeff = collider_friction[i]
+    if w <= 0.0 or friction_coeff < 0.0:
+        return
+
+    beg = collider_mat_offsets[i]
+    end = collider_mat_offsets[i + 1]
+
+    u0 = -collider_velocities[i]
+    for b in range(beg, end):
+        u_i = collider_mat_columns[b]
+        u0 += collider_mat_values[b] * velocity[u_i]
+
+    n = collider_normals[i]
+
+    u = solve_coulomb_isotropic(friction_coeff, n, u0 - (impulse[i] + collider_adhesion[i] * n) * w)
+
+    delta_u = u - u0
+    delta_lambda = delta_u / w
+
+    impulse[i] += delta_lambda
+    delta_impulse[i] = delta_lambda
+
+
+@wp.func
+def _apply_subgrid_impulse_node(
+    u_i: int,
+    tr_collider_mat_offsets: wp.array[int],
+    tr_collider_mat_columns: wp.array[int],
+    tr_collider_mat_values: wp.array[float],
+    inv_mass: wp.array[float],
+    impulses: wp.array[wp.vec3],
+    velocities: wp.array[wp.vec3],
+):
+    # contact_solver_kernels.apply_subgrid_impulse
+    block_beg = tr_collider_mat_offsets[u_i]
+    block_end = tr_collider_mat_offsets[u_i + 1]
+
+    delta_f = wp.vec3(0.0)
+    for b in range(block_beg, block_end):
+        delta_f += tr_collider_mat_values[b] * impulses[tr_collider_mat_columns[b]]
+
+    velocities[u_i] += inv_mass[u_i] * delta_f
+
+
+@wp.func
+def _bsr_mv_row(
+    alpha: float,
+    A_offsets: wp.array[int],
+    A_row_counts: wp.array[int],
+    A_columns: wp.array[int],
+    A_values: wp.array3d[float],
+    x: wp.array[float],
+    beta: float,
+    y: wp.array[float],
+    row: int,
+    subrow: int,
+):
+    # warp.sparse bsr_mv_kernel (non-tiled form, as bsr_mv launches it off CUDA), block_cols = 3
+    block_rows = A_values.shape[1]
+
+    yi = row * block_rows + subrow
+
+    scalar_zero = float(0)
+    v = scalar_zero
+
+    if alpha != scalar_zero:
+        beg = A_offsets[row]
+        end = _bsr_row_end(A_offsets, A_row_counts, row)
+        for block in range(beg, end):
+            xs = A_columns[block] * 3
+            for col in range(wp.static(3)):
+                v += A_values[block, subrow, col] * x[xs + col]
+        v *= alpha
+
+    if beta != scalar_zero:
+        v += beta * y[yi]
+
+    y[yi] = v
+
+
+@wp.func
+def _apply_stress_delta_jacobi_node(
+    u_i: int,
+    transposed_strain_mat_offsets: wp.array[int],
+    transposed_strain_mat_columns: wp.array[int],
+    transposed_strain_mat_values: wp.array[mat13],
+    inv_mass_matrix: wp.array[float],
+    stress: wp.array[vec6],
+    velocities: wp.array[wp.vec3],
+):
+    # rheology_solver_kernels.apply_stress_delta_jacobi
+    inv_mass = inv_mass_matrix[u_i]
+
+    block_beg = transposed_strain_mat_offsets[u_i]
+    block_end = transposed_strain_mat_offsets[u_i + 1]
+
+    delta_u = wp.vec3(0.0)
+    for b in range(block_beg, block_end):
+        tau_i = transposed_strain_mat_columns[b]
+        delta_stress = stress[tau_i]
+        delta_u += _symmetric_part_transposed_op(transposed_strain_mat_values[b], delta_stress)
+
+    velocities[u_i] += inv_mass * delta_u
+
+
+@wp.struct
+class ContactArgs:
+    collider_mat_offsets: wp.array[int]
+    collider_mat_columns: wp.array[int]
+    collider_mat_values: wp.array[float]
+    tr_collider_mat_offsets: wp.array[int]
+    tr_collider_mat_columns: wp.array[int]
+    tr_collider_mat_values: wp.array[float]
+    collider_friction: wp.array[float]
+    collider_adhesion: wp.array[float]
+    collider_normals: wp.array[wp.vec3]
+    collider_delassus_diagonal: wp.array[float]
+    collider_velocities: wp.array[wp.vec3]
+    collider_velocities_flat: wp.array[float]
+    impulse: wp.array[wp.vec3]
+    delta_impulse: wp.array[wp.vec3]
+    delta_impulse_flat: wp.array[float]
+    collider_env_offsets: wp.array[int]
+    collider_count: int
+
+
+@wp.struct
+class RigidityArgs:
+    J_offsets: wp.array[int]
+    J_row_counts: wp.array[int]
+    J_columns: wp.array[int]
+    J_values: wp.array3d[float]
+    IJtm_offsets: wp.array[int]
+    IJtm_row_counts: wp.array[int]
+    IJtm_columns: wp.array[int]
+    IJtm_values: wp.array3d[float]
+    IJtm_row_count: int
+    delta_body_qd: wp.array[float]
+    env_row_offsets: wp.array[int]  # environment -> range in env_rows; the last range: rows of no environment
+    env_rows: wp.array[int]
+
+
+@wp.struct
+class RheologyArgs:
+    yield_params: wp.array[YieldParamVec]
+    strain_node_volume: wp.array[float]
+    compliance_mat_offsets: wp.array[int]
+    compliance_mat_columns: wp.array[int]
+    compliance_mat_values: wp.array[mat66]
+    strain_mat_offsets: wp.array[int]
+    strain_mat_columns: wp.array[int]
+    strain_mat_values: wp.array[mat13]
+    transposed_strain_mat_offsets: wp.array[int]
+    transposed_strain_mat_columns: wp.array[int]
+    transposed_strain_mat_values: wp.array[mat13]
+    delassus_diagonal: wp.array[vec6]
+    delassus_rotation: wp.array[mat55]
+    elastic_strain_delta: wp.array[vec6]
+    stress: wp.array[vec6]
+    delta_stress: wp.array[vec6]
+    strain_env_offsets: wp.array[int]
+    inv_volume: wp.array[float]
+    velocity: wp.array[wp.vec3]
+    velocity_env_offsets: wp.array[int]
+
+
+_KERNELS = {}
+
+
+def make_fused_kernel(
+    has_viscosity: bool, has_dilatancy: bool, has_compliance_mat: bool, has_rigidity: bool, kernel_options: dict
+):
+    key = (has_viscosity, has_dilatancy, has_compliance_mat, has_rigidity, BLOCK_DIM, tuple(sorted(kernel_options.items())))
+    if key in _KERNELS:
+        return _KERNELS[key]
+
+    compute_local_strain = make_compute_local_strain(has_compliance_mat, -1)
+    solve_local_stress = make_solve_local_stress(has_viscosity, has_dilatancy)
+
+    @fem.cache.dynamic_kernel(suffix=key, kernel_options=kernel_options)
+    def fused_jacobi_iterations(
+        iterations: int,
+        env_count: int,
+        contact: ContactArgs,
+        rigidity: RigidityArgs,
+        rheology: RheologyArgs,
+    ):
+        env, lane = wp.tid()
+
+        # ranges of this threadgroup; the last group (env == env_count) takes the items of no environment
+        c_beg = int(0)
+        c_end = int(0)
+        v_beg = int(0)
+        v_end = int(0)
+        s_beg = int(0)
+        s_end = int(0)
+        if env < env_count:
+            c_beg = contact.collider_env_offsets[env]
+            c_end = contact.collider_env_offsets[env + 1]
+            v_beg = rheology.velocity_env_offsets[env]
+            v_end = rheology.velocity_env_offsets[env + 1]
+            s_beg = rheology.strain_env_offsets[env]
+            s_end = rheology.strain_env_offsets[env + 1]
+        else:
+            c_beg = contact.collider_env_offsets[env_count]
+            c_end = contact.collider_count
+        r_beg = int(0)
+        r_end = int(0)
+        if wp.static(has_rigidity):
+            r_beg = rigidity.env_row_offsets[env]
+            r_end = rigidity.env_row_offsets[env + 1]
+
+        for _it in range(iterations):
+            # --- _SubgridContactSolver.solve: solve_subgrid_friction
+            for i in range(c_beg + lane, c_end, wp.static(BLOCK_DIM)):
+                _solve_subgrid_friction_node(
+                    i,
+                    rheology.velocity,
+                    contact.collider_mat_offsets,
+                    contact.collider_mat_columns,
+                    contact.collider_mat_values,
+                    contact.collider_friction,
+                    contact.collider_adhesion,
+                    contact.collider_normals,
+                    contact.collider_delassus_diagonal,
+                    contact.collider_velocities,
+                    contact.impulse,
+                    contact.delta_impulse,
+                )
+            _tg_barrier()
+            # apply_subgrid_impulse
+            for u_i in range(v_beg + lane, v_end, wp.static(BLOCK_DIM)):
+                _apply_subgrid_impulse_node(
+                    u_i,
+                    contact.tr_collider_mat_offsets,
+                    contact.tr_collider_mat_columns,
+                    contact.tr_collider_mat_values,
+                    rheology.inv_volume,
+                    contact.delta_impulse,
+                    rheology.velocity,
+                )
+            _tg_barrier()
+            if wp.static(has_rigidity):
+                # apply_rigidity_operator: delta_body_qd = -IJtm @ delta_impulse
+                for k in range(3 * r_beg + lane, 3 * r_end, wp.static(BLOCK_DIM)):
+                    _bsr_mv_row(
+                        -1.0,
+                        rigidity.IJtm_offsets,
+                        rigidity.IJtm_row_counts,
+                        rigidity.IJtm_columns,
+                        rigidity.IJtm_values,
+                        contact.delta_impulse_flat,
+                        0.0,
+                        rigidity.delta_body_qd,
+                        rigidity.env_rows[k // 3],
+                        k - (k // 3) * 3,
+                    )
+                _tg_barrier()
+                # collider_velocity += J @ delta_body_qd
+                for k in range(3 * c_beg + lane, 3 * c_end, wp.static(BLOCK_DIM)):
+                    _bsr_mv_row(
+                        1.0,
+                        rigidity.J_offsets,
+                        rigidity.J_row_counts,
+                        rigidity.J_columns,
+                        rigidity.J_values,
+                        rigidity.delta_body_qd,
+                        1.0,
+                        contact.collider_velocities_flat,
+                        k // 3,
+                        k - (k // 3) * 3,
+                    )
+                _tg_barrier()
+            # --- _JacobiSolver.solve: jacobi_solve_kernel
+            for tau_i in range(s_beg + lane, s_end, wp.static(BLOCK_DIM)):
+                if rheology.strain_mat_offsets[tau_i] == rheology.strain_mat_offsets[tau_i + 1]:
+                    rheology.delta_stress[tau_i] = vec6(0.0)
+                else:
+                    local_strain = compute_local_strain(
+                        tau_i,
+                        rheology.compliance_mat_offsets,
+                        rheology.compliance_mat_columns,
+                        rheology.compliance_mat_values,
+                        rheology.strain_mat_offsets,
+                        rheology.strain_mat_columns,
+                        rheology.strain_mat_values,
+                        rheology.elastic_strain_delta,
+                        rheology.velocity,
+                        rheology.stress,
+                    )
+                    rheology.delta_stress[tau_i] = solve_local_stress(
+                        tau_i,
+                        local_strain,
+                        rheology.yield_params,
+                        rheology.strain_node_volume,
+                        rheology.delassus_diagonal,
+                        rheology.delassus_rotation,
+                        rheology.stress,
+                    )
+            _tg_barrier()
+            # apply_stress_delta_jacobi
+            for u_i in range(v_beg + lane, v_end, wp.static(BLOCK_DIM)):
+                _apply_stress_delta_jacobi_node(
+                    u_i,
+                    rheology.transposed_strain_mat_offsets,
+                    rheology.transposed_strain_mat_columns,
+                    rheology.transposed_strain_mat_values,
+                    rheology.inv_volume,
+                    rheology.delta_stress,
+                    rheology.velocity,
+                )
+            _tg_barrier()
+            # array_axpy(x=delta_stress, y=stress, alpha=1, beta=1): y = beta * y + alpha * x
+            for tau_i in range(s_beg + lane, s_end, wp.static(BLOCK_DIM)):
+                alpha = float(1.0)
+                beta = float(1.0)
+                rheology.stress[tau_i] = beta * rheology.stress[tau_i] + alpha * rheology.delta_stress[tau_i]
+            _tg_barrier()
+
+    _KERNELS[key] = fused_jacobi_iterations
+    return fused_jacobi_iterations
