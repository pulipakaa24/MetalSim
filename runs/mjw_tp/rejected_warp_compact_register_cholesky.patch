+//
+// Storage: a lane's c-th column (jc = lane + c*BD >= c*BD) only ever holds rows i >= c*BD, so column
+// slot c keeps N - c*BD rows in one flat register array (slot offsets metal_rc_off). For 32 < N <= 64
+// this is N + (N - 32) registers per lane instead of 2N (54 instead of 86 for N = 43), which keeps the
+// factor out of spilled thread memory. The arithmetic and its order are unchanged.
+constexpr int metal_rc_off(int c, int n, int bd) { return c * n - bd * c * (c - 1) / 2; }
+constexpr int metal_rc_idx(int c, int i, int n, int bd) { return metal_rc_off(c, n, bd) + (i >= c * bd ? i - c * bd : 0); }
