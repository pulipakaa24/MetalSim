          </body>
        </body>
      </worldbody>
    
        <!-- Equality constraint tying the two bodies together -->
      <equality>
        <!-- type="weld" constrains body positions; here link1 follows link2 -->
        <weld name="body_couple" body1="link1"/>
      </equality>
    </mujoco>
