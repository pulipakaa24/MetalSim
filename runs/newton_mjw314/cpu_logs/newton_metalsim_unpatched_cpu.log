        model = builder.finalize()
    
        state_0 = model.state()
        state_1 = model.state()
        newton.eval_fk(model, model.joint_q, model.joint_qd, state_0)
        collision_pipeline = newton.CollisionPipeline(model, rigid_contact_max=sphere_count)
        contacts = collision_pipeline.contacts()
