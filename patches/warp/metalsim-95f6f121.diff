+    GRID_TYPE_UINT32: (28, 64, 32, 8, 32, 8256, 270400, 1088, 33856, 96, 2144),
+    GRID_TYPE_VEC4F: (28, 96, 128, 16, 64, 8288, 532576, 1120, 66656, 128, 8320),
+    GRID_TYPE_VEC4D: (32, 160, 256, 32, 64, 8320, 1056896, 1152, 132224, 160, 16544),
