index b2e7592faa78b13352551595915dd5c750bdc40c..40b94ac9b80089517c8b9af04465251ca51f2070 100644
--- a/warp/config.py
+++ b/warp/config.py
@@ -348,6 +348,127 @@ directly as a context manager.
 Note: Impacts performance when active due to call-stack introspection.
 """
 
+metal_register_cholesky_max: int = 40
+"""Largest matrix dimension that ``tile_cholesky`` factors in registers on Metal (one SIMD group,
+lanes own columns, SIMD-shuffle broadcasts, no barriers); larger matrices use the cooperative scalar
+path with a threadgroup barrier per column. Read when a module is built (part of its hash). Above
+about 64 the per-lane column registers spill."""
+
+metal_register_solve: bool = _os.environ.get("WP_METAL_REGISTER_SOLVE", "1") != "0"
+"""Whether ``tile_cholesky_solve`` with a vector right-hand side runs the register triangular solves on
+Metal (one SIMD group, lanes own columns, SIMD sums and shuffles, no barriers in the sweeps) for
+matrices up to ``metal_register_cholesky_max``; False keeps the cooperative scalar path (two threadgroup
+barriers per row per sweep). Read when a module is built (part of its hash)."""
+
+metal_compact_register_cholesky: bool = _os.environ.get("WP_METAL_COMPACT_REGISTER_CHOLESKY", "0") != "0"
+"""Metal register Cholesky and register solve for 33..64 rows: hold the lane's second column compactly (rows
+>= 32 only, 54 instead of 86 registers at n = 43) and skip the rows it cannot have. Same operations in the same
+order (bitwise). Off by default: measured 5-8 % slower than the generic two-column form at n = 43 / 48 (the
+cost is not register spill), kept for A/B. Read when a module is built (part of its hash)."""
+
+metal_rolled_cholesky: int = int(_os.environ.get("WP_METAL_ROLLED_CHOLESKY", "0"))
+"""Metal register Cholesky: above this matrix size (0 = never) the rolled form runs: same lane layout and
+operations in the same order, runtime loops (per-lane column arrays in thread memory, a few hundred instructions
+of code instead of ~n^2 unrolled). Experimental (2026-09-26); read when a module is built (part of its hash)."""
+
+metal_chol_split: bool = _os.environ.get("WP_METAL_CHOL_SPLIT", "0") == "1"
+"""Metal register Cholesky: use the split-loop step (scalar column pivots, second column guarded by the
+compile-time row index; the same products in the same order as the generic step, bitwise). Off by default: on the
+tile path it measures the same as the generic step (0.971 vs 0.973 ms per 4096 at n = 43); it is 7x faster than the
+generic step only in a native-snippet context, where the generic step compiles badly. Part of the module hash."""
+
+metal_gpu_volume: bool = _os.environ.get("WP_METAL_GPU_VOLUME", "1") != "0"
+"""Whether :meth:`warp.Volume.allocate_by_tiles` / :meth:`warp.Volume.allocate_by_voxels` (non-rebuildable),
+:meth:`warp.Volume.rebuild`, :meth:`warp.Volume.get_voxels` and :meth:`warp.Volume.get_tiles` run as GPU kernels
+on Metal devices (the key-based builder of ``volume_builder.cpp``; the grid buffers are byte for byte the host
+builder's). Rebuilds then need no host synchronization. False drains the GPU and runs the host builder on unified
+memory, as before. Rebuildable allocation always uses the host builder. Read at each call."""
+
+metal_fast_math: str = _os.environ.get("WP_METAL_FAST_MATH", "off")
+"""How modules with the ``fast_math`` option compile on Metal. NVRTC's ``--use_fast_math`` makes every float32
+division of such a module ``div.approx.ftz.f32`` (SASS ``MUFU.RCP`` + ``FMUL.FTZ``) and ``sqrtf``
+``sqrt.approx.ftz.f32`` (``MUFU.SQRT``). ``"cuda"``: the same results bit for bit, from an exact integer emulation of
+the two ``MUFU`` instructions (``warp/native/metal_cuda_fast_math.h``). ``"relaxed"``: Metal's relaxed math mode
+(reassociation kept off): ``metal::fast::divide`` / ``metal::fast::sqrt``, Apple's approximations, faster, not CUDA's
+bits, and the sign of zero is not honoured. ``"off"``: ``fast_math`` is ignored (correctly rounded division and
+sqrt). Read when a ``fast_math`` module is hashed (in practice when its kernels are defined or first loaded) and
+part of its hash: set it before defining such kernels; ``WP_METAL_FAST_MATH`` sets it.
+
+The default is ``"off"``, the precise lowering every Metal module had before ``fast_math`` was honoured on Metal:
+the ``"cuda"`` emulation costs about 3x a correctly rounded division or square root, and either approximate form
+would change the results of every ``fast_math`` kernel a program already runs (MuJoCo Warp's ray casts, Newton's
+ray and collision helpers). Code that wants CUDA's fast_math semantics opts in (MetalSim's MPM:
+``newton_compat.install(metal_fast_math=...)``)."""
+
+metal_device_args: bool | str = {"1": True, "0": False}.get(_os.environ.get("WP_METAL_DEVICE_ARGS", "auto"), "auto")
+"""Address space Metal kernels read their argument structs and launch bounds from: ``"auto"`` (default) decides per
+kernel, ``True`` uses ``device const`` pointers for every kernel, ``False`` ``constant`` ones for every kernel. The
+module option ``"metal_device_args"`` (``True`` / ``False``) overrides it for a module or a kernel.
+
+Apple GPUs preload the constant data a kernel reads at every dispatch, a fixed cost growing with the argument fields
+it uses (~0.25 us per array descriptor), and then keep it in uniform registers; device arguments skip the preload but
+are loaded per thread. Short kernels dispatched many times are faster with device arguments (Newton MPM granular:
+39.5 -> 34.1 ms per frame, from the Gauss-Seidel color pass), kernels that keep many arguments live through long
+bodies or tiles are much slower (MuJoCo Warp G1 physics step at 4,096 worlds: 47.5 ms constant, 54.4 ms device).
+``"auto"`` gives device arguments to kernels without tiles whose generated statement count (the kernel body plus
+the user functions it calls, inlined) is at most :data:`metal_device_args_max_cost`, and to longer kernels without
+tiles in launches of at most :data:`metal_device_args_max_threads` threads. A kernel whose device form the
+Metal compiler cannot build (its compiler service fails on MuJoCo Warp's ``_tendon_dot`` that way) falls back to
+constant arguments when it is loaded, with a warning. Results are bitwise the same in every mode. Read when a module
+is built (part of the module hash unless ``False``); ``WP_METAL_DEVICE_ARGS=1`` / ``0`` / ``auto``."""
+
+metal_device_args_max_cost: int = int(_os.environ.get("WP_METAL_DEVICE_ARGS_MAX_COST", "200"))
+"""Largest generated statement count (kernel body plus inlined user functions) of a kernel that gets device-memory
+arguments in every launch under ``metal_device_args = "auto"``. Read when a module is built."""
+
+metal_device_args_max_threads: int = int(_os.environ.get("WP_METAL_DEVICE_ARGS_MAX_THREADS", "1024"))
+"""Under ``metal_device_args = "auto"``, kernels without tiles that are longer than :data:`metal_device_args_max_cost`
+read device-memory arguments in launches of at most this many threads (dispatch-bound: the preload of constant
+arguments dominates) and constant ones in larger launches. Read at each launch."""
+
+metal_cuda_libm: bool = _os.environ.get("WP_METAL_CUDA_LIBM", "1") != "0"
+"""Whether float32 :func:`warp.log`, :func:`warp.exp`, :func:`warp.sinh` and the reciprocal square root inside
+:func:`warp.svd3` / :func:`warp.eig3` compute on Metal what they compute on CUDA, bit for bit. On CUDA they are
+libdevice's ``__nv_logf`` / ``__nv_expf`` / ``__nv_sinhf`` (``expf`` and ``sinhf`` go through the approximate
+``ex2.approx`` instruction) and ``rsqrt.approx.f32``; the Metal library's ``log`` / ``exp`` / ``sinh`` and a
+correctly rounded ``1 / sqrt`` round differently on 3-50 % of inputs. ``True`` (the default) uses
+``warp/native/metal_cuda_libm.h`` (the PTX sequences NVRTC emits, with the ``MUFU.EX2`` / ``MUFU.RSQ`` table
+interpolators of Benjamin Carleton's sass-math model), equal to an NVIDIA L4's results on all 2^32 inputs; ``False``
+the Metal library's functions. Read when a module is built and part of the module hash when ``True``;
+``WP_METAL_CUDA_LIBM=0`` turns it off."""
+
+metal_eager_conditionals: bool = _os.environ.get("WP_METAL_EAGER_CONDITIONALS", "0") == "1"
+"""Whether :func:`warp.capture_while` and :func:`warp.capture_if` outside a graph capture on Metal record their
+bodies once as a graph gated on the device (indirect execution ranges a kernel closes once the condition is 0), so
+the host reads the condition once per batch of loop iterations (``capture_while``) or not at all (``capture_if``)
+instead of before every iteration. Same kernels in the same order (bitwise the host loop). Bodies that record host
+operations keep the host loop. Off by default: the body's Python code then runs once per call (as under a CUDA
+graph capture), not once per iteration, and the measured gain is small (MuJoCo Warp's solver loop in Newton's
+example_mpm_anymal: host waits per frame 17 -> 10, frame 41.3 -> 40.7 ms). Read at each call."""
+
+metal_gpu_utilities: bool = _os.environ.get("WP_METAL_GPU_UTILITIES", "1") != "0"
+
+metal_capture_reuse: bool = _os.environ.get("WP_METAL_CAPTURE_REUSE", "1") != "0"
+"""Metal graph capture: buffers of 64 KiB or more freed during a capture are reused by later allocations of the same
+capture, as in a CUDA graph's memory pool (replays are serial). Without it a capture of several simulation steps holds
+every step's temporaries at once. Read when a capture begins. Environment: ``WP_METAL_CAPTURE_REUSE``.
+"""
+
+metal_bounded_launch: bool = _os.environ.get("WP_METAL_BOUNDED_LAUNCH", "1") != "0"
+"""Honor device-side launch bounds on Metal (``wp.launch(..., dim_limit=...)``, also used by ``warp.fem`` and the GPU
+utilities for fixed-capacity buffers): only the threadgroups below the bound are dispatched, sized on the GPU.
+``False`` (or ``WP_METAL_BOUNDED_LAUNCH=0``) runs every such launch over its full ``dim`` instead, as on other
+devices; results are the same either way."""
+"""Whether :func:`warp.utils.radix_sort_pairs`, :func:`warp.utils.runlength_encode` and integer
+:func:`warp.utils.array_scan` run as GPU kernels on Metal devices (bitwise the same results as the host
+implementations, no host synchronization, recordable into graph captures as kernel dispatches). False runs them
+on the host after draining the GPU, as before. Floating-point scans always run on the host. Read at each call.
