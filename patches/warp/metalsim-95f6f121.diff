+    if constexpr (WP_TILE_BLOCK_DIM > 1 && WP_TILE_BLOCK_DIM <= 32 && n <= WP_METAL_REGISTER_CHOLESKY_MAX) {
+        metal_register_cholesky_update<Upper>(A, X, count);
