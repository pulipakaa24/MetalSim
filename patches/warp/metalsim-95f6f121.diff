+GRID_TYPE_FLOAT = 1
+GRID_TYPE_DOUBLE = 2
+GRID_TYPE_INT32 = 4
+GRID_TYPE_INT64 = 5
+GRID_TYPE_VEC3F = 6
+GRID_TYPE_VEC3D = 7
+GRID_TYPE_UINT32 = 10
+GRID_TYPE_VEC4F = 17
+GRID_TYPE_VEC4D = 18
+GRID_TYPE_INDEX = 19
+GRID_TYPE_ONINDEX = 20
