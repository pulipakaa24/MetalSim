+    metal_register_forward_step2<0, n, BD, T>(c0, c1, y, b, lane);
+    metal_register_backward_step2<n - 1, n, BD, T>(c0, c1, y, x, lane);
+
+    X.data(tile_coord(lane)) = x[0];
+    if (jc1 < n)
+        X.data(tile_coord(jc1)) = x[1];
+    WP_TILE_SYNC();
+}
