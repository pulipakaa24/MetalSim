+            _transpose_keys_u64 if wide else _transpose_keys_u32,
+            dim=n,
+            device=device,
+            inputs=[row_count, bsr_offsets, bsr_row_counts, bsr_columns, wp.int64(sentinel), keys, indices],
+        )
