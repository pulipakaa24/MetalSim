+    for (size_t i = 0; i < count; ++i) {
+        const Graph::Dispatch& d = graph->dispatches[i];
+        id<MTLIndirectComputeCommand> cmd = [icb indirectComputeCommandAtIndex:i];
+        [cmd setComputePipelineState:d.pipeline];
+        if (d.bounds_size) {
