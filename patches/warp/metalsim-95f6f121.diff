+    GRID_TYPE_DOUBLE: (32, 96, 64, 8, 32, 8256, 270400, 1088, 33856, 128, 4224),
+    GRID_TYPE_INT32: (28, 64, 32, 8, 32, 8256, 270400, 1088, 33856, 96, 2144),
+    GRID_TYPE_INT64: (32, 96, 64, 8, 32, 8256, 270400, 1088, 33856, 128, 4224),
