+                pts = pts.astype(np.float32)
+                # and the float32 neighbours of the half-way points
+                pts = np.concatenate(
+                    [pts, np.nextafter(pts, np.float32(np.inf)), np.nextafter(pts, np.float32(-np.inf))]
