+        b = wp.zeros(1, dtype=wp.uint64, device=self.device)
+        wp.launch(umax64, 1000, inputs=[m, b], device=self.device)
+        self.assertEqual(int(m.numpy()[0]), 999 << 33)
+        self.assertEqual(int(b.numpy()[0]), 2**64 - 1)
