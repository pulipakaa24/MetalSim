+    }
+#endif
+    auto idx = [](int r, int c) { return Upper ? tile_coord(c, r) : tile_coord(r, c); };  // L[r, c]
+    WP_TILE_SYNC();
+    if (WP_TILE_THREAD_IDX == 0) {
+        for (int v = 0; v < count; ++v) {
+            T x[n];
+            for (int i = 0; i < n; ++i)
+                x[i] = X.data(tile_coord(v, i));
+            for (int k = 0; k < n; ++k) {
+                const T Lkk = A.data(idx(k, k));
