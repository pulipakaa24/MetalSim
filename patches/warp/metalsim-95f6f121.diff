+// x * x minus the 19 low columns of the antidiagonal and of the first 9 partial-product rows (sass-math squarer).
+inline ulong wp_mufu_square_approx(ulong x)
+{
+    ulong anti = 0;
+    for (int i = 0; i < 16; ++i)
