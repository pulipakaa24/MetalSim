+        bvh.num_items = 0;
+        return;
+    }
+    if (num_items > INT_MAX / 2) {
+        fprintf(stderr, "Error: Primitive count %d is too large and would cause an integer overflow.\n", num_items);
+        bvh.num_items = 0;
+        return;
+    }
+    const int max_nodes = 2 * num_items - 1;
