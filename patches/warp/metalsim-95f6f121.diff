+    T col[CPL][n];
+    T b[CPL];
+    T y[CPL];
+    T x[CPL];
+#pragma clang loop unroll(full)
+    for (int c = 0; c < CPL; ++c) {
+        const int jc = lane + c * BD;
+        b[c] = (active && jc < n) ? Y.data(tile_coord(jc)) : T {};
+        y[c] = T {};
+        x[c] = T {};
