+    descriptor.inheritBuffers = NO;
+    descriptor.maxKernelBufferBindCount = 2;
+    if ([descriptor respondsToSelector:@selector(setMaxKernelThreadgroupMemoryBindCount:)])
+        descriptor.maxKernelThreadgroupMemoryBindCount = 1;
