+    for (int cc = 0; cc < CPL; ++cc) {
+        const int jr = lane + cc * BD;
+#pragma clang loop unroll(full)
+        for (int j = 0; j < n; ++j)
+            row[cc][j] = (jr < n && j <= jr) ? A.data(idx(jr, j)) : T {};
