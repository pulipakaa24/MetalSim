+            wp.launch(
+                _transpose_columns_counted,
+                dim=n,
+                device=device,
+                inputs=[stored, row_count, wp.int64(sentinel), keys, indices, transposed_columns, block_indices],
+            )
+        else:
+            wp.launch(
+                _transpose_columns,
+                dim=n,
+                device=device,
+                inputs=[
+                    n,
+                    row_count,
+                    wp.int64(sentinel),
+                    keys,
+                    indices,
+                    int(not padded),
+                    transposed_columns,
+                    block_indices,
+                ],
+            )
+
+    if padded:
+        wp.launch(
+            _transpose_scatter_padded,
+            dim=col_count,
+            device=device,
+            inputs=[
+                n,
+                row_count,
+                wp.int64(sentinel),
+                exceeded_status,
+                keys,
+                indices,
+                transposed_offsets,
+                transposed_row_counts,
+                transposed_columns,
+                block_indices,
+                status,
+            ],
+        )
+    elif bounded:
+        wp.launch(
+            _transpose_offsets_counted,
+            dim=col_count + 1,
+            device=device,
+            inputs=[stored, row_count, wp.int64(sentinel), keys, transposed_offsets],
+        )
+    else:
+        wp.launch(
+            _transpose_offsets,
+            dim=col_count + 1,
+            device=device,
+            inputs=[n, row_count, wp.int64(sentinel), keys, transposed_offsets],
+        )
