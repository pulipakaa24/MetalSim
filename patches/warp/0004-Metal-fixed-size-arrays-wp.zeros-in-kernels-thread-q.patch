index 82a7516..b1f3f9e 100644
--- a/warp/native/array.h
+++ b/warp/native/array.h
@@ -384,6 +384,62 @@ add(const fixedarray_t<Size, T> WP_THREAD& a, const fixedarray_t<Size, T> WP_THR
 {
