+@wp.kernel
+def compute_body_forces_lanes(
+    dt: float,
+    node_count: int,
+    collider_ids: wp.array[int],
+    collider_impulses: wp.array[wp.vec3],
+    collider_impulse_pos: wp.array[wp.vec3],
+    body_ids: wp.array[int],
+    body_q: wp.array[wp.transform],
+    body_com: wp.array[wp.vec3],
+    body_f_lanes: wp.array2d[wp.spatial_vector],
+):
+    """Sum the sand forces on one body over one lane's share of the grid nodes, in node order.
+
+    Fixed-order counterpart of :func:`compute_body_forces` for devices whose float atomics are not
+    reproducible run to run (Metal): lane ``l`` adds nodes ``l, l + L, l + 2L, ...`` below
+    ``node_count``; :func:`sum_body_force_lanes` adds the lanes in lane order.
+    """
+
+    body_index, lane = wp.tid()
+    lane_count = body_f_lanes.shape[1]
+
+    X_wb = body_q[body_index]
+    com = wp.transform_point(X_wb, body_com[body_index])
+
+    f = wp.spatial_vector()
+    for i in range(lane, node_count, lane_count):
+        cid = collider_ids[i]
+        if cid >= 0 and cid < body_ids.shape[0]:
+            if body_ids[cid] == body_index:
+                f_world = collider_impulses[i] / dt
+                r = collider_impulse_pos[i] - com
+                f += wp.spatial_vector(f_world, wp.cross(r, f_world))
+    body_f_lanes[body_index, lane] = f
+
+
+@wp.kernel
+def sum_body_force_lanes(
+    body_f_lanes: wp.array2d[wp.spatial_vector],
+    body_f: wp.array[wp.spatial_vector],
+):
+    body_index = wp.tid()
+    f = body_f[body_index]
+    for lane in range(body_f_lanes.shape[1]):
+        f += body_f_lanes[body_index, lane]
+    body_f[body_index] = f
+
+
