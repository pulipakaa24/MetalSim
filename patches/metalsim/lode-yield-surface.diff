+@wp.func
+def lode_sin3theta(r_world: vec6):
+    """sin(3 theta) of a world-frame (DB16-mapped, compression-positive) stress: +1 at triaxial compression (one
+    principal stress above the two others), -1 at triaxial extension, 0 in pure shear and for a zero deviator."""
+    dev = r_world
+    dev[0] = 0.0
+    j2 = wp.length_sq(dev)  # the DB16 mapping is orthonormal for (tau : tau) / 2, so |dev|^2 = J2
+    if j2 <= 1.0e-30:
+        return 0.0
+    j3 = wp.determinant(fem.SymmetricTensorMapper.dof_to_value_3d(dev))
+    return wp.clamp(2.598076211353316 * j3 / (j2 * wp.sqrt(j2)), -1.0, 1.0)
+
+
+@wp.func
+def lode_scale(sin3theta: float, mu: float):
+    """k(theta) = M(theta) / mu: the factor on the Drucker-Prager deviatoric radius (sqrt(J2) <= mu p) that gives the
+    selected Lode-dependent surface with friction angle phi = atan(mu). Mohr-Coulomb: k(0) = cos(phi), so the radius in
+    pure shear is p sin(phi) + c cos(phi); phi -> 0 gives (rounded) Tresca with sqrt(J2) = c in pure shear."""
+    phi = wp.max(wp.atan(wp.max(mu, 0.0)), _LODE_PHI_MIN)
+    s = wp.sin(phi)
+    m_c = 6.0 * s / (3.0 - s)
+    if wp.static(_LODE_SURFACE == 2):
+        # Matsuoka-Nakai: A1 = (K - 3) / (K - 9), A2 = K / (K - 9), K = (9 - s^2) / (1 - s^2), without cancellation
+        a1 = (6.0 + 2.0 * s * s) / (8.0 * s * s)
+        a2 = (9.0 - s * s) / (8.0 * s * s)
+        alpha = (2.0 / 3.0) * wp.sqrt(a1) * m_c
+        beta = a2 / (a1 * wp.sqrt(a1))
+        gamma = 0.0
+    else:
+        # Mohr-Coulomb, inner-rounded corners
+        gbar = (6.0 / wp.pi) * wp.atan(s / wp.sqrt(3.0))
+        alpha = 1.0 / wp.cos((gbar + 1.0) * wp.pi / 6.0)
+        beta = _LODE_MC_ROUNDING
+        gamma = 1.0 - gbar
+    shape = alpha * wp.cos(wp.acos(wp.clamp(-beta * sin3theta, -1.0, 1.0)) / 3.0 - gamma * wp.pi / 6.0)
+    return m_c / (wp.sqrt(3.0) * shape * wp.tan(phi))
 
 
 @wp.func
+def lode_scale_bounds(mu: float):
+    """Range of k(theta) over all Lode angles: the largest is at triaxial compression for both surfaces; the smallest
+    is at triaxial extension for Matsuoka-Nakai but mid-face (tan theta = -sin(phi) / sqrt(3)) for Mohr-Coulomb."""
+    phi = wp.max(wp.atan(wp.max(mu, 0.0)), _LODE_PHI_MIN)
+    s3_face = wp.sin(-3.0 * wp.atan(wp.sin(phi) / wp.sqrt(3.0)))
+    k_lo = wp.min(lode_scale(-1.0, mu), lode_scale(s3_face, mu))
+    return k_lo, lode_scale(1.0, mu)
+
+
+@wp.func
+def yield_friction(yield_params: YieldParamVec):
+    """The material friction coefficient mu (sqrt(J2) <= mu p) of a yield parameter vector."""
+    p_max = yield_params[0]
+    return wp.where(p_max > 0.0, wp.max(0.0, yield_params[3] / p_max), 0.0) * wp.sqrt(3.0 / 2.0)
+
+
+@wp.func
+def lode_scale_world(r_world: vec6, yield_params: YieldParamVec):
+    return lode_scale(lode_sin3theta(r_world), yield_friction(yield_params))
+
+
+@wp.func
+def lode_scale_local(r_local: vec6, rotation: mat55, yield_params: YieldParamVec):
+    """As :func:`lode_scale_world` for a stress in the local (Delassus eigenbasis) frame: the 5x5 rotation does not
+    preserve J3, so the deviator is rotated back to the world frame first."""
+    return lode_scale_world(_local_to_world(r_local, rotation), yield_params)
+
+
