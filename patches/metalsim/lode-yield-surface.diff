+def make_solve_flow_rule(has_viscosity: bool = True, has_dilatancy: bool = True):
+    key = (has_viscosity, has_dilatancy)
+    given_scale = make_solve_flow_rule_given_scale(has_dilatancy)
+
+    @fem.cache.dynamic_func(suffix=key)
+    def solve_flow_rule_aniso_impl(
+        D: vec6,
+        b: vec6,
+        r_guess: vec6,
+        yield_params: YieldParamVec,
+        strain_node_volume: float,
+        rotation: mat55,
+    ):
+        if wp.static(has_viscosity):
+            # Empty strain modes have no material viscosity to apply.
+            if strain_node_volume > 0.0:
+                D_visc = vec6(1.0) + get_viscosity(yield_params) / strain_node_volume * D
+                D = wp.cw_div(D, D_visc)
+                b = wp.cw_div(b, D_visc)
+
+        if wp.static(_USE_CAM_CLAY):
+            return solve_flow_rule_camclay(D, b, r_guess, yield_params)
+
+        # Lode factor: the root of g(k) = F(k) - k, F(k) = k(theta of the stress r = (u(k) - b) / D). An elastic trial
+        # stress is kept after one solve (F(k0) = k0). g >= 0 at the smallest k over all Lode angles and <= 0 at the
+        # largest, so [k_a, k_b] brackets the root: secant steps, bisection when a step leaves the bracket
+        # (_LODE_MAX_SOLVES solves at most).
+        k0 = lode_scale_local(-wp.cw_div(b, D), rotation, yield_params)
+        u = wp.static(given_scale)(D, b, yield_params, k0)
+        g0 = lode_scale_local(wp.cw_div(u - b, D), rotation, yield_params) - k0
+        if wp.abs(g0) <= _LODE_TOL * k0:
+            return u
+        k_a, k_b = lode_scale_bounds(yield_friction(yield_params))
+        if g0 > 0.0:
+            k_a = wp.max(k_a, k0)
+        else:
+            k_b = wp.min(k_b, k0)
+        k1 = wp.clamp(k0 + g0, k_a, k_b)
+        u = wp.static(given_scale)(D, b, yield_params, k1)
+        g1 = lode_scale_local(wp.cw_div(u - b, D), rotation, yield_params) - k1
+        for _solve in range(_LODE_MAX_SOLVES - 2):
+            if wp.abs(g1) <= _LODE_TOL * k1:
+                break
+            if g1 > 0.0:
+                k_a = wp.max(k_a, k1)
+            else:
+                k_b = wp.min(k_b, k1)
+            k2 = 0.5 * (k_a + k_b)
+            den = g1 - g0
+            if wp.abs(den) > 1.0e-12:
+                k_sec = k1 - g1 * (k1 - k0) / den
+                if k_sec > k_a and k_sec < k_b:
+                    k2 = k_sec
+            k0 = k1
+            g0 = g1
+            k1 = k2
+            u = wp.static(given_scale)(D, b, yield_params, k1)
+            g1 = lode_scale_local(wp.cw_div(u - b, D), rotation, yield_params) - k1
+        return u
+
     return solve_flow_rule_aniso_impl
 
 
