 _ISOTROPIC_LOCAL_LHS = wp.constant(False)
 """Use isotropic local left-hand side instead of anisotropic. Cheaper local solver but slower convergence. Development toggle for experimentation."""
 
+# MetalSim: Lode-dependent yield surface (research_notes/sand_fidelity/PLAN_2026-10-14.md section 17). The deviatoric
+# yield radius of the Drucker-Prager cone is scaled by k(theta) = M(theta) / mu, with M the generalized-classical
+# Lode function (Lagioia & Panteghini 2016) and phi = atan(mu), so that a cohesionless material has the friction
+# angle atan(mu) (Mohr-Coulomb) at every Lode angle. The Lode angle is taken from the world-frame deviator.
+_LODE_SURFACE = wp.constant(1)
+"""Lode-dependent yield surface: 1 = Mohr-Coulomb with inner-rounded corners, 2 = Matsuoka-Nakai (matched at the
+triaxial compression / extension corners). Set by scripts/vendor_mpm_variant.py per variant (pr4660mc, pr4660mn)."""
 
+_LODE_MC_ROUNDING = wp.constant(0.9999)
+"""Generalized-classical beta for the Mohr-Coulomb corners (1 = sharp). 0.9999: friction angle at most 0.33 deg below phi (phi <= 50 deg), at the triaxial corners."""
+
+_LODE_MAX_SOLVES = wp.constant(8)
+"""Most anisotropic flow-rule solves per local stress update. The Lode factor k solves k = F(k) = k(theta(stress(k)))
+(the D-metric projection turns the deviator, so theta moves): first k from the trial stress, then fixed-point and
+secant steps safeguarded by bisection inside the range of k over all Lode angles (lode_scale_bounds), which brackets
+the root. Compile-time bound."""
+
+_LODE_TOL = wp.constant(1.0e-5)
+"""Stop when |F(k) - k| <= _LODE_TOL * k (the stress then lies on the surface to about this relative error)."""
+
+_LODE_PHI_MIN = wp.constant(0.01)
+"""Smallest friction angle [rad] used in the Lode function (its phi -> 0 limit is regular; float32 safety)."""
+
