From f85879cd44bd6439d4fa7bace80dd67702184885 Mon Sep 17 00:00:00 2001
From: pulipakaa24 <adipu@utexas.edu>
Date: Sat, 31 Oct 2026 18:50:07 -0700
Subject: [PATCH 25/31] Heightfield prisms with a margin: GJK on the uninflated
 shapes first, as MuJoCo C's mjc_ccd

With a margin or gap (HFIELD_TRUE_DISTANCE: prism and geom each inflated by half of margin + gap) every prism within margin + gap of a mesh or box went through EPA on the inflated, smooth shapes, iterating to the tolerance (up to ccd_iterations). MuJoCo C's mjc_ccd shrinks any pair with a margin to the underlying geoms ("special handling for sphere, capsule, and margin"): GJK on the discrete shapes, and when they are apart the contact is that distance less the margins (_inflate); only overlapping shapes go on to GJK + EPA on the inflated shapes. Upstream MuJoCo Warp does the same for non-heightfield pairs (has_non_hfield_margin, 23efc9a). HFIELD_MARGIN_SHRINK (default True) does it for heightfield prisms.

No effect at margin = gap = 0 (the heightfield contact checks are bitwise unchanged). With Isaac Lab 3.0's 1 cm geom gap on the G1's terrain colliders, the separated prisms' distances are exact (EPA had them to about 2e-7 m, with normals of neighbouring prisms 0.3 deg apart, so the duplicate test kept near-copies: 144701 -> 144199 contacts on 40000 foot placements, deepest contact unchanged to 1.1 um), and the collision costs less.

test_hfield_mesh_gap_distance: a box corner 4 mm above the heightfield with gap 0.01 per geom; EPA on the inflated shapes returned 4.000172 mm.
---
 mujoco_warp/_src/collision_driver_test.py | 25 ++++++++++++++++++++
 mujoco_warp/_src/collision_gjk.py         | 28 +++++++++++++++++++++--
 2 files changed, 51 insertions(+), 2 deletions(-)

diff --git a/mujoco_warp/_src/collision_driver_test.py b/mujoco_warp/_src/collision_driver_test.py
index a52cef2..7ebeeb4 100644
--- a/mujoco_warp/_src/collision_driver_test.py
+++ b/mujoco_warp/_src/collision_driver_test.py
@@ -1119,6 +1119,31 @@ class CollisionTest(parameterized.TestCase):
     np.testing.assert_allclose(dist[i], 0.015, atol=1e-6)
     np.testing.assert_allclose(pos[i, 2], 0.0075, atol=1e-6)
 
+  def test_hfield_mesh_gap_distance(self):
+    """Box mesh corner 4 mm above a flat heightfield, gap 0.01 per geom: dist is the separation.
+
+    Isaac Lab 3.0's G1 setting; GJK on the uninflated shapes (HFIELD_MARGIN_SHRINK, as MuJoCo C's
+    mjc_ccd) gives it exactly, EPA on the inflated shapes only to its tolerance.
+    """
+    dist, normal, _ = self._hfield_contacts("""
+    <mujoco>
+      <asset>
+        <hfield name="h" nrow="11" ncol="11" size=".5 .5 .1 .1"/>
+        <mesh name="b" vertex="-.05 -.03 -.02  .05 -.03 -.02  -.05 .03 -.02  .05 .03 -.02
+                               -.05 -.03  .02  .05 -.03  .02  -.05 .03  .02  .05 .03  .02"/>
+      </asset>
+      <worldbody>
+        <geom type="hfield" hfield="h" gap=".01"/>
+        <body><freejoint/><geom type="mesh" mesh="b" gap=".01"/></body>
+      </worldbody>
+      <keyframe><key qpos=".0501 .0423 .035326693 .943714364 .189307857 .038134576 .268535823"/></keyframe>
+    </mujoco>
+    """)
+    i = np.argmin(dist)
+    # EPA on the inflated shapes (HFIELD_MARGIN_SHRINK False) returned 4.000172 mm here
+    np.testing.assert_allclose(dist[i], 0.004, atol=5e-8)
+    np.testing.assert_allclose(normal[i], [0.0, 0.0, 1.0], atol=1e-5)
+
   def test_min_friction(self):
     with self.assertWarns(UserWarning):
       _, _, _, d = test_data.fixture(
diff --git a/mujoco_warp/_src/collision_gjk.py b/mujoco_warp/_src/collision_gjk.py
index f880ab5..ed9dc7d 100644
--- a/mujoco_warp/_src/collision_gjk.py
+++ b/mujoco_warp/_src/collision_gjk.py
@@ -43,6 +43,17 @@ MAXVAL2 = 1e30
 # clear of a prism came back 25.6 mm deep with normal (0, 0, 1); MetalSim docs/research/hfield_contacts_2026-10-31.md).
 # False restores upstream's override.
 HFIELD_PRISM_POLYTOPE = True
+# MetalSim: a heightfield prism pair with a margin (HFIELD_TRUE_DISTANCE: prism and geom each
+# inflated by half of margin + gap) runs as MuJoCo C's mjc_ccd runs any pair with a margin ("special
+# handling for sphere, capsule, and margin (shrink to underlying geom)"): GJK on the uninflated,
+# discrete shapes; if they are apart, the contact is that distance less the margins (_inflate) and
+# EPA does not run; only overlapping shapes go on to GJK + EPA on the inflated shapes. Without it
+# every prism within margin + gap of the geom ran EPA on the inflated (smooth, non-discrete) shapes
+# to the tolerance (up to ccd_iterations iterations): Isaac Lab 3.0's 1 cm geom gap made the G1's
+# rough terrain contacts about 2x costlier and filled EPA's horizon. Upstream MuJoCo Warp does the
+# same for non-heightfield pairs (gdm/main 23efc9a, has_non_hfield_margin). No effect at margin =
+# gap = 0. False: every margin case on EPA.
+HFIELD_MARGIN_SHRINK = True
 
 # polytope minimal interior distance to origin
 MIN_DIST2 = 1e-10
@@ -2664,22 +2675,35 @@ def gjk_phase(
   # determine if the geoms being tested are discrete
   is_discrete = _discrete_geoms(geomtype1, geomtype2) and (geom1.margin == 0.0 and geom2.margin == 0.0)
 
+  # MetalSim: heightfield prism pairs with a margin shrink to the underlying geoms
+  # (HFIELD_MARGIN_SHRINK)
+  shrink = wp.static(HFIELD_MARGIN_SHRINK) and geomtype1 == GeomType.HFIELD and (orig_margin1 > 0.0 or orig_margin2 > 0.0)
+
   # special handling for sphere and capsule (shrink to point and line respectively)
   if geomtype1 == GeomType.SPHERE or geomtype1 == GeomType.CAPSULE:
     size1 = geom1.size[0]
     full_margin1 = size1 + 0.5 * orig_margin1
     geom1.margin = 0.0
     geom1.size = wp.vec3(0.0, geom1.size[1], geom1.size[2])
+  elif shrink:
+    full_margin1 = 0.5 * orig_margin1
+    geom1.margin = 0.0
 
   if geomtype2 == GeomType.SPHERE or geomtype2 == GeomType.CAPSULE:
     size2 = geom2.size[0]
     full_margin2 = size2 + 0.5 * orig_margin2
     geom2.margin = 0.0
     geom2.size = wp.vec3(0.0, geom2.size[1], geom2.size[2])
+  elif shrink:
+    full_margin2 = 0.5 * orig_margin2
+    geom2.margin = 0.0
 
-  if size1 + size2 > 0.0:
+  if size1 + size2 > 0.0 or shrink:
     cutoff += full_margin1 + full_margin2
-    result = gjk(tolerance, gjk_iterations, geom1, geom2, x_1, x_2, geomtype1, geomtype2, cutoff, is_discrete)
+    shrunk_discrete = bool(is_discrete)
+    if shrink:
+      shrunk_discrete = _discrete_geoms(geomtype1, geomtype2) and geom1.margin == 0.0 and geom2.margin == 0.0
+    result = gjk(tolerance, gjk_iterations, geom1, geom2, x_1, x_2, geomtype1, geomtype2, cutoff, shrunk_discrete)
     geom1.index = result.index1
     geom2.index = result.index2
 
