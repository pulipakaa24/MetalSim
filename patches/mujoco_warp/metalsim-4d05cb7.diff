+@wp.kernel
+def _bitonic_step_f32(keys: wp.array2d[float], vals: wp.array2d[int], j: int, k: int):
+  w, i = wp.tid()
+  l = i ^ j
+  if l > i:
+    a = keys[w, i]
+    b = keys[w, l]
+    va = vals[w, i]
+    vb = vals[w, l]
+    a_gt_b = a > b or (a == b and va > vb)
+    if a_gt_b == ((i & k) == 0):
+      keys[w, i] = b
+      keys[w, l] = a
+      vals[w, i] = vb
+      vals[w, l] = va
+
+
+@wp.kernel
+def _bitonic_step_i64(keys: wp.array2d[wp.int64], vals: wp.array2d[int], j: int, k: int):
+  w, i = wp.tid()
+  l = i ^ j
+  if l > i:
+    a = keys[w, i]
+    b = keys[w, l]
+    va = vals[w, i]
+    vb = vals[w, l]
+    a_gt_b = a > b or (a == b and va > vb)
+    if a_gt_b == ((i & k) == 0):
+      keys[w, i] = b
+      keys[w, l] = a
+      vals[w, i] = vb
+      vals[w, l] = va
+
