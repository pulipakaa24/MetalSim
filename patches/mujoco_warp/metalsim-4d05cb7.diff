+_JTDAJ_GROUPS_PER_WORLD = int(os.environ.get("MJW_JTDAJ_GROUPS_PER_WORLD", "0"))
+_JTCJ_SM_FACTOR = int(os.environ.get("MJW_JTCJ_SM_FACTOR", "6"))
