+  def test_horizon_is_loop(self):
+    """MetalSim: the horizon test that decides whether EPA's face scan deleted a disk."""
+    self.assertTrue(_horizon_is_loop_np([(0, 1), (1, 2), (2, 0)]))
+    self.assertTrue(_horizon_is_loop_np([(3, 4), (0, 1), (4, 0), (2, 3), (1, 2)]))  # any order and orientation
+    # two regions touching at a vertex: a figure-8 through the walk's start vertex (1) and through
+    # another vertex (2)
+    self.assertFalse(_horizon_is_loop_np([(0, 1), (0, 2), (2, 1), (1, 3), (3, 4), (4, 1)]))
+    self.assertFalse(_horizon_is_loop_np([(0, 1), (1, 2), (2, 0), (2, 3), (3, 4), (4, 2)]))
+    # loops 1-0-2-3 and 2-4-5 in an order where a walk that ignores the second edge at vertex 2 uses
+    # all 7 edges (0 -> 2 -> 4 -> 5 -> 2 -> 0) before it closes
+    self.assertFalse(_horizon_is_loop_np([(0, 1), (2, 3), (5, 2), (2, 4), (0, 2), (4, 5), (3, 1)]))
+    # two disjoint loops (a ring of deleted faces)
+    self.assertFalse(_horizon_is_loop_np([(0, 1), (1, 2), (2, 0), (3, 4), (4, 5), (5, 3)]))
+    self.assertFalse(_horizon_is_loop_np([(0, 1), (1, 2), (2, 3)]))  # open path
+    self.assertFalse(_horizon_is_loop_np([(0, 1), (1, 2)]))  # fewer than 3 edges
+    self.assertFalse(_horizon_is_loop_np([(0, 1), (1, 2), (2, 0)], nhorizon=-1))  # buffer overflow
