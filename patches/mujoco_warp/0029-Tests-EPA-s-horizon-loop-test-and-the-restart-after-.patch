+  def test_epa_nonloop_horizon(self, bodies, qpos, tol):
+    """MetalSim: poses where EPA's face scan leaves a horizon that is not one loop (full buffer).
+
+    The scan is undone and the region grows from the closest face (MuJoCo C's horizon); the result
+    is the C contact. The scan's own answer happens to be the same on these poses, so this pins the
+    restart, not a change of result.
+    """
+    mjm, mjd, m, d = test_data.fixture(
+      xml=f"<mujoco><worldbody>{bodies}</worldbody><keyframe><key qpos='{qpos}'/></keyframe></mujoco>", keyframe=0
+    )
+    mjw.kinematics(m, d)
+    mjw.collision(m, d)
+    nacon = d.nacon.numpy()[0]
+    self.assertGreater(nacon, 0)
+    self.assertEqual(d.overflow.numpy()[0], 0)
+    self.assertGreater(mjd.ncon, 0)
+    self.assertAlmostEqual(d.contact.dist.numpy()[:nacon].min(), mjd.contact.dist[: mjd.ncon].min(), delta=tol)
+
