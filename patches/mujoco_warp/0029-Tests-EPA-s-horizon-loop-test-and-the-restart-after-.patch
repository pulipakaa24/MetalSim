   return dist_out.numpy()[0], ncon_out.numpy()[0], pos_out.numpy()[0], pos_out.numpy()[1]
 
 
+@wp.kernel(module="unique", enable_backward=False)
+def _horizon_is_loop_kernel(horizon: wp.array[int], nhorizon: int, is_loop_out: wp.array[int]):
+  pt = Polytope()
+  pt.horizon = horizon
+  pt.nhorizon = nhorizon
+  is_loop_out[0] = wp.where(_horizon_is_loop(pt), 1, 0)
+
+
+def _horizon_is_loop_np(edges, nhorizon=None) -> bool:
+  """MetalSim: _horizon_is_loop on a horizon of vertex index pairs (EPA's edge encoding)."""
+  horizon = wp.array([(min(a, b) << 10) | max(a, b) for a, b in edges] or [0], dtype=int)
+  is_loop = wp.zeros(1, dtype=int)
+  wp.launch(_horizon_is_loop_kernel, dim=1, inputs=[horizon, len(edges) if nhorizon is None else nhorizon], outputs=[is_loop])
+  return bool(is_loop.numpy()[0])
+
+
