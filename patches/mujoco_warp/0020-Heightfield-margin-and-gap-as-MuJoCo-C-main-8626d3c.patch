From 7f6310dbcb35b683b6766e4dfc57557953e7f7a5 Mon Sep 17 00:00:00 2001
From: pulipakaa24 <adipu@utexas.edu>
Date: Sat, 31 Oct 2026 16:34:37 -0700
Subject: [PATCH 20/23] Heightfield margin and gap as MuJoCo C main (8626d3c)

HFIELD_TRUE_DISTANCE (default True): the prism is inflated like the other geom (half of margin + gap
each) instead of its top being raised by margin, the geom's bounds are expanded by margin + gap
before the prism height test, and dist is the separation of the surfaces, as every other CCD pair
and as MuJoCo C main's 'Fix margin and gap double-counting in heightfield collisions' (test
MjcConvexTest.HFieldMarginAndGap: sphere 15 mm clear, terrain margin 0.02 gap 0.01 -> dist 0.015,
contact z 0.0075; reproduced). The plane path likewise. _hfield_filter adds the geoms' gaps.
False restores MuJoCo C 3.14's form (dist = separation - 1.5 (margin + gap)). Bitwise unchanged at
margin = gap = 0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mujoco_warp/_src/collision_convex.py | 34 ++++++++++++++++++++++++----
 1 file changed, 29 insertions(+), 5 deletions(-)

diff --git a/mujoco_warp/_src/collision_convex.py b/mujoco_warp/_src/collision_convex.py
index e1033a5..db0e45c 100644
--- a/mujoco_warp/_src/collision_convex.py
+++ b/mujoco_warp/_src/collision_convex.py
@@ -65,6 +65,13 @@ HFIELD_SELECT_DEDUP = True
 # duplicate test cannot tell from a second face. Upstream's CCD kernel shifts its origin the same way ("translation
 # invariance"). False keeps the absolute frame.
 HFIELD_LOCAL_ORIGIN = True
+# MetalSim: heightfield margin convention. True (default): MuJoCo C main's (8626d3c "Fix margin and gap double-counting
+# in heightfield collisions", 2026-10-06; test MjcConvexTest.HFieldMarginAndGap): prism and geom each inflated by half of
+# margin + gap, contact while the separation is below margin + gap, dist = the separation, as every other CCD pair here.
+# False: MuJoCo C 3.14's: prism top raised by margin + gap and geom inflated by half of it, dist = separation -
+# 1.5 (margin + gap), contact while the separation is below margin + gap (upstream MuJoCo Warp raises by margin only).
+# Identical at margin = gap = 0.
+HFIELD_TRUE_DISTANCE = True
 HFIELD_DUP_DIST = 1.0e-4
 HFIELD_DUP_COS = 0.99999962  # cos(0.05 deg)
 from mujoco_warp._src.math import upper_trid_index
@@ -98,6 +105,7 @@ def _hfield_filter(
   geom_size: wp.array2d[wp.vec3],
   geom_rbound: wp.array2d[float],
   geom_margin: wp.array2d[float],
+  geom_gap: wp.array2d[float],
   mesh_vertadr: wp.array[int],
   mesh_vertnum: wp.array[int],
   mesh_graphadr: wp.array[int],
@@ -135,6 +143,8 @@ def _hfield_filter(
 
   # TODO(team): margin?
   margin = geom_margin[margin_id, g1] + geom_margin[margin_id, g2]
+  # MetalSim: plus the gap, as MuJoCo C (mjc_ConvexHField receives margin + gap)
+  margin += geom_gap[worldid % geom_gap.shape[0], g1] + geom_gap[worldid % geom_gap.shape[0], g2]
 
   # box-sphere test: horizontal plane
   for i in range(2):
@@ -310,6 +320,7 @@ def ccd_hfield_kernel_builder(
       geom_size,
       geom_rbound,
       geom_margin,
+      geom_gap,
       mesh_vertadr,
       mesh_vertnum,
       mesh_graphadr,
@@ -449,6 +460,13 @@ def ccd_hfield_kernel_builder(
     # reported dist is therefore C's: separation - 1.5 * (margin + gap)
     hfmargin = margin + gap
     geom2.margin = hfmargin
+    # prism top raise (MuJoCo C 3.14) or prism inflation (C main: support offset by half the margin, as geom2)
+    zraise = float(0.0)
+    if wp.static(HFIELD_TRUE_DISTANCE):
+      geom1.margin = hfmargin
+      zmin = zmin - hfmargin  # C main expands the geom's bounds by the margin before the prism height test
+    else:
+      zraise = hfmargin
 
     # EPA memory
     epa_vert = epa_vert_in[ccdid]
@@ -467,7 +485,7 @@ def ccd_hfield_kernel_builder(
       for init_i in range(2):
         x = x0
         y = dy * float(r + dr[init_i] - rmin) + y0
-        z = hfield_data[adr + (r + dr[init_i]) * ncol + cmin] * size[2] + hfmargin - org[2]
+        z = hfield_data[adr + (r + dr[init_i]) * ncol + cmin] * size[2] + zraise - org[2]
 
         prism[0] = prism[1]
         prism[1] = prism[2]
@@ -497,7 +515,7 @@ def ccd_hfield_kernel_builder(
           # add vert
           x = dx * float(c - cmin) + x0
           y = dy * float(r + dr[i] - rmin) + y0
-          z = hfield_data[adr + (r + dr[i]) * ncol + c] * size[2] + hfmargin - org[2]
+          z = hfield_data[adr + (r + dr[i]) * ncol + c] * size[2] + zraise - org[2]
 
           prism[0] = prism[1]
           prism[1] = prism[2]
@@ -535,9 +553,13 @@ def ccd_hfield_kernel_builder(
             if tn_len < 1.0e-12:
               continue
             tn = tn / tn_len
-            best_depth = float(0.0)
             best_p = wp.vec3(0.0, 0.0, 0.0)
-            infl = 0.5 * hfmargin
+            infl = float(0.0)
+            best_depth = float(0.0)
+            if wp.static(HFIELD_TRUE_DISTANCE):
+              best_depth = hfmargin
+            else:
+              infl = 0.5 * hfmargin
             nvert = geom2.vertnum
             if geomtype2 != int(GeomType.MESH) or nvert > 256:
               nvert = 1
@@ -558,7 +580,7 @@ def ccd_hfield_kernel_builder(
               if (e0 >= -tol and e1 >= -tol and e2 >= -tol) or (e0 <= tol and e1 <= tol and e2 <= tol):
                 best_depth = depth
                 best_p = pv
-            if best_depth >= 0.0:
+            if best_depth >= wp.where(wp.static(HFIELD_TRUE_DISTANCE), hfmargin, 0.0):
               continue
             dist = best_depth
             hfield_contact_dist[count] = dist
@@ -598,6 +620,8 @@ def ccd_hfield_kernel_builder(
 
             if ncontact == 0 or dist >= 0.0:
               continue
+            if wp.static(HFIELD_TRUE_DISTANCE):
+              dist += hfmargin  # inflated shapes -> separation of the surfaces (both inflated by hfmargin / 2)
 
             # cache contact information
             hfield_contact_dist[count] = dist
