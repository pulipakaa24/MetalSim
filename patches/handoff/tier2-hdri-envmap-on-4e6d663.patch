+inline float3 env_dir(float2 uv, float yaw) {
+    float phi = (uv.x - 0.5) * 2.0 * PI - yaw, th = uv.y * PI;
+    return float3(sin(th) * cos(phi), sin(th) * sin(phi), cos(th));
