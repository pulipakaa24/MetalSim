+def env_sampling_table(hdr, grid=(512, 256)):
+    """Importance-sampling table of an equirectangular map on a (gw, gh) grid: pixel weight
+    luminance x sin(theta); returns ([marginal CDF (gh) | row CDFs (gh*gw) | density over (u, v)], gw, gh)."""
+    import cv2
+    hdr = np.asarray(hdr, np.float32)[..., :3]
+    gw, gh = min(grid[0], hdr.shape[1]), min(grid[1], hdr.shape[0])
+    small = cv2.resize(hdr, (gw, gh), interpolation=cv2.INTER_AREA)
+    lum = small @ np.array([0.2126, 0.7152, 0.0722], np.float32)
+    sin_t = np.sin((np.arange(gh) + 0.5) / gh * np.pi)[:, None]
+    w = np.maximum(lum, 1e-6 * max(float(lum.max()), 1e-6)) * sin_t          # never zero: MIS needs full support
+    row = w.sum(1)
+    marg = np.cumsum(row) / row.sum()
+    cond = np.cumsum(w, 1) / row[:, None]
+    density = w / w.sum() * (gw * gh)                                          # pdf over (u, v) in [0, 1]^2
+    return np.concatenate([marg, cond.ravel(), density.ravel()]).astype(np.float32), gw, gh
+
