+// ---- environment map: equirectangular, u = azimuth (atan2(y, x) + yaw), v = polar angle from +z
+inline float2 env_uv(float3 d, float yaw) {
+    float u = atan2(d.y, d.x) / (2.0 * PI) + 0.5 + yaw / (2.0 * PI);
+    return float2(u - floor(u), acos(clamp(d.z, -1.0f, 1.0f)) / PI);
