.venv/
.venv-newtonfork/
upstream/
scratch/
__pycache__/
*.pyc
*.egg-info/
build/
docs/measurements/*.raw

# NVIDIA Isaac assets are fetched, not committed (scripts/fetch_isaac_assets.sh)
assets/isaac/**/*.usd
assets/isaac/franka_pour/
# conversions of NVIDIA's assets (e.g. an MJCF written from g1_minimal.usd) are derived works: keep them local
assets/isaac/**/*_from_usd.xml
.venv-flex/
.venv-*/

# macOS / MuJoCo droppings
.DS_Store
MUJOCO_LOG.TXT

# run outputs: console captures, checkpoints and the GPU queue's state (logs under runs/ are committed)
runs/*.stdout
*.pt
runs/policies/
runs/.gpu_lock
runs/.gpu_lock.d/
runs/gpu_queue/
runs/gpu_hb/
runs/gpu_shared/
.pytest_cache/
scripts/diagnostics/competitors/menagerie/

# MPM / rigid-scale bulk outputs are regenerated, not committed (metalsim/physics/mpm/MPM.md, "Reproducing"):
# per-tree Warp kernel caches, particle recordings and the L4 tarballs; their logs, JSON and reports are committed
runs/**/kcache*/
runs/mpm/**/*.npz
runs/mpm/**/*.tgz
runs/mpm/**/*.nsys-rep
runs/parity/isaaclab3_mpm*/**/*.npz
runs/parity/isaaclab3_mpm*/*.tgz
runs/fma_rigid_parity/**/*.npz
runs/rigid_perf/**/*.npz

# Poly Haven CC0 HDRIs and textures are fetched, not committed (scripts/fetch_polyhaven_assets.sh)
assets/polyhaven/

# public 3D Gaussian splat scenes are fetched, not committed (scripts/fetch_splat_scenes.sh; InteriorGS forbids redistribution)
assets/splats/

# stray working copies
m/
guest@*/

# scene heightfields derived from scans of real spaces stay local (regenerate with metalsim.tron1.scene)
assets/tron1/scenes_local/

# private fork checkouts of an agent worktree (scripts/setup_*.sh use upstream/ in the main checkout)
_forks/

# film tool bulk outputs (metalsim/render/film): frames, recordings, render twins and full-resolution masters are
# regenerated; their JSON and logs are committed
runs/film/**/frames/
runs/film/**/rec.npz
runs/film/**/twin*
runs/film/**/master.mp4
